{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaiduPanLite",
  "version": "0.2.0",
  "identifier": "com.lite.baidupan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "百度网盘 Lite",
        "width": 1080,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "zhounan36@163.com",
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
